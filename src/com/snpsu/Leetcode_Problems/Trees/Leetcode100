/**
 * Definition for a binary tree node.
 * public class TreeNode {
 *     int val;
 *     TreeNode left;
 *     TreeNode right;
 *     TreeNode() {}
 *     TreeNode(int val) { this.val = val; }
 *     TreeNode(int val, TreeNode left, TreeNode right) {
 *         this.val = val;
 *         this.left = left;
 *         this.right = right;
 *     }
 * }
 */
class Solution {
    public boolean isSameTree(TreeNode p, TreeNode q) {
        // both are empty together - same!
        if(p==null && q==null){
            return true;
        }
        // one of them is emptying first - false
        if(p==null || q==null){
            return false;
        }
        // there values are different - false!
        if(p.val != q.val){
            return false;
        }
        // recursively check both the trees
        return isSameTree(p.left, q.left)
                && isSameTree(p.right, q.right);
    }
}