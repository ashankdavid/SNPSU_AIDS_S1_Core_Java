class Solution {
    public boolean isValid(String s) {
        Stack<Character> stack = new Stack<>();
        for(char ch : s.toCharArray()){
            if(ch=='(' || ch=='{' || ch=='['){
                stack.push(ch);
            }else{
                if(stack.isEmpty()){
                    return false;
                }
                char Top = stack.pop();
                if(ch==')' && Top !='('){
                    return false;
                }
                if(ch=='}' && Top !='{'){
                    return false;
                }
                if(ch==']' && Top !='['){
                    return false;
                }
            }
        }
        return stack.isEmpty();
    }
}